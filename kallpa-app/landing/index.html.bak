<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>KALLPA — Eventos y Alta Cocina · Oruro, Bolivia</title>
<meta name="description" content="KALLPA — Eventos y Alta Cocina en Oruro, Bolivia. Menús completos, coctelería, bocaditos y servicio de garzones para tu evento.">
<link rel="icon" type="image/png" href="img/kallpa-perfil-redes.png">
<link rel="apple-touch-icon" href="img/kallpa-perfil-redes.png">
<meta property="og:title" content="KALLPA — Eventos y Alta Cocina">
<meta property="og:description" content="Alta cocina para tus eventos en Oruro, Bolivia.">
<meta property="og:image" content="img/kallpa-logo-claro.png">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#fff;--head:#1e293b;--menu:#94a3b8;--brand:#880042;--plum:#4d2339;--gold:#ffbc0d;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#161013;--head:#f3e9ee}}
:root[data-theme="dark"]{--bg:#161013;--head:#f3e9ee}
html{scroll-behavior:smooth;scroll-padding-top:calc(90px + env(safe-area-inset-top,0px))}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);font-family:Poppins,system-ui,sans-serif;color:var(--head);line-height:1.6}
a{text-decoration:none;color:inherit}
h1,h2,h3{margin:0;line-height:1.2}
.w{max-width:1140px;margin:0 auto;padding:0 20px}
.bt{display:inline-block;background:var(--brand);color:#fff;padding:12px 28px;font:500 16px Poppins,sans-serif;border:0;cursor:pointer;border-radius:0}
.dv{height:0;border-top:2.6px solid #fff;width:50%;margin:15px auto}
/* header */
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:50;background:var(--bg)}
.hd{display:grid;grid-template-columns:1fr 2.2fr 1fr 1fr;align-items:center;min-height:90px;gap:10px}
.logo{display:flex;align-items:center;justify-content:center;gap:10px;font-weight:600;color:var(--brand);font-size:20px}
.logo img{height:64px;width:auto;display:block}
.logo .lg-osc{display:none}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .logo .lg-cla{display:none}
 :root:not([data-theme="light"]) .logo .lg-osc{display:block}}
:root[data-theme="dark"] .logo .lg-cla{display:none}
:root[data-theme="dark"] .logo .lg-osc{display:block}
.mn{display:flex;justify-content:flex-end}
.mn a{padding:15px;font-weight:500;color:var(--menu);font-size:15px}
.mn a:hover,.tel a:hover{color:var(--brand)}
.tel a{color:var(--menu);font-weight:400;font-size:15px}
.tc{text-align:center}
.burger{display:none;background:none;border:0;font-size:26px;color:var(--brand);cursor:pointer}
.mob{display:none;text-align:center;color:var(--brand);font-size:13px;font-weight:500;line-height:1.3}
@media(max-width:860px){.hd{grid-template-columns:1fr 1fr 1fr}.mn,.tel,.tc{display:none}.mob{display:block}.burger{display:block;justify-self:end}
 .mn.open{display:flex;flex-direction:column;position:absolute;left:0;right:0;top:100%;background:var(--bg);box-shadow:0 8px 14px rgba(0,0,0,.15)}}
/* hero */
.hero{position:relative;height:min(78vh,620px);min-height:487px;overflow:hidden;color:#fff}
.sl{position:absolute;inset:0;opacity:0;transition:opacity 1s;display:flex;align-items:center}
.sl.on{opacity:1}
.sl:before{content:"";position:absolute;inset:0;background:#00000082}
.sl:nth-child(1){background:url("img/foto-1.jpeg") center/cover no-repeat}
.sl:nth-child(2){background:url("img/foto-2.jpeg") center/cover no-repeat}
.sl:nth-child(3){background:url("img/foto-5.jpeg") center/cover no-repeat}
.sl .w{position:relative;width:100%;padding-left:90px}
.sl h4{margin:0 0 8px;font-size:22px;font-weight:500;letter-spacing:1px}
.sl h2{font-size:clamp(34px,6vw,58px);font-weight:600;max-width:760px;margin-bottom:14px}
.sl h2 b{color:var(--gold);font-weight:600}
.sl p{font-size:clamp(17px,2.4vw,24px);font-weight:300;line-height:1.2;max-width:620px;margin:0}
.dots{position:absolute;right:28px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:16px;z-index:3}
.dots button{background:none;border:0;color:var(--gold);font:600 13px Poppins;cursor:pointer;padding:0;opacity:.55;display:flex;align-items:center;gap:8px;flex-direction:row-reverse}
.dots button:before{content:"";width:10px;height:10px;border-radius:50%;background:var(--gold)}
.dots button.on{opacity:1}
.soc{position:absolute;left:24px;bottom:34px;display:flex;flex-direction:column;gap:18px;z-index:3;font-weight:600;font-size:16px;writing-mode:vertical-rl;transform:rotate(180deg)}
@media(max-width:700px){.sl .w{padding-left:50px}.soc{left:10px;font-size:13px}}
/* nosotros */
.nos{background:var(--plum);color:#fff;text-align:center;padding:100px 0;min-height:400px;display:flex;align-items:center}
.nos h3{font-size:clamp(26px,4vw,40px);font-weight:500}
.nos p{font-size:20px;font-weight:300;margin:0}
.ban{min-height:284px;display:grid;place-items:center;text-align:center;padding:20px;color:#fff;background:linear-gradient(#00000080,#00000080),linear-gradient(120deg,#6b3a4d,#a1304f 50%,#d0a26b)}
.ban h1{font-size:clamp(28px,5vw,44px);font-weight:600}
.val{padding:50px 0 0;text-align:center}
.val h2{font-size:27px;font-weight:600}
.val h4{font-size:24px;font-weight:600;margin:0}
.val .dv{border-color:var(--head)}
.vg{display:grid;grid-template-columns:repeat(4,1fr);margin:30px 0 50px;gap:0}
.vg div{border:10px solid var(--bg);min-height:430px;display:grid;place-items:center;color:#fff;font-size:30px;font-weight:600;background:linear-gradient(#00000080,#00000080),linear-gradient(135deg,#880042,#d0a26b)}
.vg div:nth-child(2){background:linear-gradient(#00000080,#00000080),linear-gradient(135deg,#4d2339,#a1304f)}
.vg div:nth-child(3){background:linear-gradient(#00000080,#00000080),linear-gradient(135deg,#8a5b2a,#d99a3d)}
.vg div:nth-child(4){background:linear-gradient(#00000080,#00000080),linear-gradient(135deg,#3a2a30,#880042)}
@media(max-width:860px){.vg{grid-template-columns:1fr 1fr}.vg div{min-height:230px}}
/* servicios */
.sv{background:var(--plum);color:#fff;text-align:center;padding:80px 0}
.sv .w{max-width:1040px}
.sv h2.t{font-size:clamp(34px,5vw,48px);font-weight:600;line-height:1.17}
.sv h4{font-size:27px;font-weight:600;margin:0 0 12px}
.sv .ds{font-size:20px;margin:0 0 30px;line-height:1.4;letter-spacing:.15px}
.cg{display:grid;grid-template-columns:repeat(3,1fr);text-align:left}
.cd{background:#fff;margin:10px;transition:box-shadow .3s}
.cd:hover{box-shadow:0 4px 8px rgba(0,0,0,.1)}
.cd .im{height:210px;display:grid;place-items:center;font-size:54px;background:linear-gradient(135deg,#880042,#d0a26b)}
.cd:nth-child(3n+2) .im{background:linear-gradient(135deg,#4d2339,#a1304f)}
.cd:nth-child(3n) .im{background:linear-gradient(135deg,#8a5b2a,#d99a3d)}
.cd h3{font-size:24px;font-weight:400;color:#333;padding:24px 24px 0;margin-bottom:16px}
.cd p{font-size:14px;line-height:1.617;color:#777;padding:0 24px;margin:0 0 20px}
@media(max-width:900px){.cg{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.cg{grid-template-columns:1fr}.cd{margin:0 0 20px}}
/* galeria */
.ga{padding:50px 0;text-align:center}
.ga h2{font-size:clamp(34px,5vw,48px);font-weight:600;margin-bottom:24px}
.tk{display:flex;gap:10px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:12px}
.tk div{flex:0 0 calc((100% - 20px)/3);height:260px;scroll-snap-align:start;background-size:cover;background-position:center}
.tk div:nth-child(1){background-image:url("img/foto-1.jpeg")}
.tk div:nth-child(2){background-image:url("img/foto-2.jpeg")}
.tk div:nth-child(3){background-image:url("img/foto-3.jpeg")}
.tk div:nth-child(4){background-image:url("img/foto-4.jpeg")}
.tk div:nth-child(5){background-image:url("img/foto-5.jpeg")}
.tk div:nth-child(6){background-image:url("img/foto-4.jpeg")}
@media(max-width:700px){.tk div{flex-basis:70%}}
.cl{padding:50px 0;text-align:center}
.cl h2{font-size:24px;font-weight:600}
.cs{display:grid;grid-template-columns:repeat(4,1fr);gap:25px;margin-top:30px}
.cs div{height:90px;border:2px solid var(--brand);display:grid;place-items:center;font-size:18px;font-weight:600;color:var(--brand)}
@media(max-width:760px){.cs{grid-template-columns:1fr 1fr}}
/* contacto */
.ct{background:linear-gradient(#00000080,#00000080),linear-gradient(135deg,#4d2339,#880042 60%,#2b1020);color:#fff;padding:40px 0 20px}
.cgd{display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:start}
@media(max-width:820px){.cgd{grid-template-columns:1fr}}
.ct h2{font-size:24px;font-weight:600;color:#f9fafb;margin-bottom:20px}
.fi{display:flex;align-items:center;gap:0;margin-bottom:8px}
.fi span{flex:0 0 61px;height:61px;border-radius:50%;background:var(--gold);color:#fff;display:grid;place-items:center;font-size:21px}
.fi div{margin:15px 30px}
.fi h3{font-size:21px;font-weight:600;margin-bottom:6px}
.fi p{margin:0;font-size:15px}
.si{display:flex;gap:29px;padding-left:10px;margin-top:14px}
.si a{width:38px;height:38px;background:var(--gold);color:#fff;display:grid;place-items:center;font-weight:600;font-size:14px}
form label{display:block;font-weight:500;margin:12px 0 4px}
form input,form textarea{width:100%;background:#ffffff8c;border:1px solid #ffffffaa;border-radius:1px;padding:6px 8px;font:inherit;color:#111;height:30px}
form textarea{height:90px}
.ck{display:grid;grid-template-columns:1fr 1fr;gap:4px 10px}
.ck label{display:flex;gap:6px;align-items:center;font-weight:400;font-size:14px;margin:0}
.ck input{width:auto;height:auto}
.mp{height:400px;display:grid;place-items:center;text-align:center;background:#e5e3df;color:#555;font-size:15px}
.mp a{color:var(--brand);font-weight:600;text-decoration:underline}
/* footer */
footer{background:var(--brand);color:#fff;padding:50px 0 20px;text-align:center}
footer h2{font-size:22px;font-weight:600;margin:14px 0 6px}
footer nav a{display:block;padding:8px;font-weight:400}
footer nav a:hover{color:var(--gold)}
footer hr{border:0;border-top:1px solid #fff;margin:18px 0}
.wa{position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));width:56px;height:56px;border-radius:50%;background:#25d366;color:#fff;display:grid;place-items:center;font-size:28px;box-shadow:0 4px 12px rgba(0,0,0,.3);z-index:60}
</style>
</head>
<body>
<header><div class="w hd">
  <a class="logo" href="#inicio" aria-label="KALLPA — Eventos y Alta Cocina">
    <img class="lg-cla" src="img/kallpa-logo-claro.svg" alt="KALLPA — Eventos y Alta Cocina">
    <img class="lg-osc" src="img/kallpa-logo-oscuro.svg" alt="KALLPA — Eventos y Alta Cocina">
  </a>
  <nav class="mn" id="mn"><a href="#inicio">Inicio</a><a href="#nosotros">Nosotros</a><a href="#servicios">Servicios</a><a href="#contacto">Contacto</a></nav>
  <div class="tel tc"><a href="tel:+59170000000">7X XXX XXX</a></div>
  <div class="tc"><a class="bt" href="#contacto">Cotizar</a></div>
  <div class="mob">COTIZA AL<br><u>7X XXX XXX</u></div>
  <button class="burger" id="bg" aria-label="Menú">☰</button>
</div></header>

<div class="hero" id="inicio">
  <div class="sl on"><div class="w"><h4>Kallpa · Eventos y Alta Cocina</h4><h2><b>Alta cocina</b> para tus eventos</h2><p>La fuerza de los Andes, servida con distinción</p></div></div>
  <div class="sl"><div class="w"><h4>Kallpa · Eventos y Alta Cocina</h4><h2><b>Eventos</b> sociales, folklóricos e institucionales</h2><p>Menús completos con cocina propia y servicio de garzones para cada ocasión</p></div></div>
  <div class="sl"><div class="w"><h4>Kallpa · Eventos y Alta Cocina</h4><h2><b>Tres líneas</b> de menú para elegir</h2><p>Clásica, Reserva y Gran Reserva, con guarniciones, postres, coctelería y bocaditos</p></div></div>
  <div class="dots" id="dots"></div>
  <div class="soc"><span>Facebook</span><span>Instagram</span></div>
</div>

<section class="nos" id="nosotros"><div class="w">
  <h3>Un servicio único, para un momento único</h3><div class="dv"></div>
  <p>KALLPA — Eventos y Alta Cocina nace en Oruro para llevar la fuerza de los Andes a tu mesa: menús de pollo, cerdo y res preparados con insumos seleccionados y servidos con distinción.</p>
</div></section>

<div class="ban"><h1>Eventos y Alta Cocina</h1></div>

<section class="val"><div class="w">
  <h2>Alta cocina para cada ocasión</h2><div class="dv"></div>
  <h4>Nuestros Valores, nuestra Misión y nuestros Servicios se distinguen por:</h4>
  <div class="vg"><div>Puntualidad</div><div>Servicio personalizado</div><div>Pasión</div><div>Calidad</div></div>
</div></section>

<section class="sv" id="servicios"><div class="w">
  <h2 class="t">Nuestros servicios</h2><div class="dv"></div>
  <h4>Menús completos para tu evento</h4>
  <p class="ds">Elige tu línea de menú y complementa con guarniciones, postres, coctelería y servicio. Nosotros nos encargamos del resto.</p>
  <div class="cg">
    <div class="cd"><div class="im">🍗</div><h3>Línea Clásica</h3><p>Nuestros platos de fondo a base de pollo: sabor casero con presentación de banquete, ideales para eventos grandes.</p></div>
    <div class="cd"><div class="im">🥩</div><h3>Línea Reserva</h3><p>Platos de fondo a base de cerdo, preparados con técnica y sazón para una mesa más especial.</p></div>
    <div class="cd"><div class="im">🍖</div><h3>Línea Gran Reserva</h3><p>Nuestra selección premium a base de res, para celebraciones que merecen lo mejor.</p></div>
    <div class="cd"><div class="im">🥗</div><h3>Guarniciones y Ensaladas</h3><p>Acompañamientos frescos y de temporada para completar cada plato de fondo.</p></div>
    <div class="cd"><div class="im">🍰</div><h3>Postres</h3><p>Cierre dulce para tu menú, elaborado en cocina propia.</p></div>
    <div class="cd"><div class="im">🍸</div><h3>Coctelería</h3><p>Barra de bebidas y cócteles para recibir y brindar con tus invitados.</p></div>
    <div class="cd"><div class="im">🥂</div><h3>Bocaditos</h3><p>Pequeñas obras de sabor para la recepción, el brindis o los eventos de pie.</p></div>
    <div class="cd"><div class="im">🤵</div><h3>Servicio de Garzones</h3><p>Personal de servicio uniformado, en proporción al número de invitados, para atender cada mesa.</p></div>
    <div class="cd"><div class="im">🎉</div><h3>Eventos a Medida</h3><p>Sociales, folklóricos, académicos e institucionales: armamos el menú y el servicio según tu evento.</p></div>
  </div>
</div></section>

<section class="ga"><div class="w">
  <h2>Galería</h2>
  <div class="tk">
    <div role="img" aria-label="Montaje de evento KALLPA"></div>
    <div role="img" aria-label="Plato de fondo KALLPA"></div>
    <div role="img" aria-label="Mesa servida KALLPA"></div>
    <div role="img" aria-label="Coctelería KALLPA"></div>
    <div role="img" aria-label="Postres KALLPA"></div>
    <div role="img" aria-label="Servicio de garzones KALLPA"></div>
  </div>
</div></section>

<section class="cl"><div class="w">
  <h2>Para cada tipo de evento</h2>
  <div class="cs"><div>Sociales</div><div>Folklóricos</div><div>Académicos</div><div>Institucionales</div></div>
</div></section>

<section class="ct" id="contacto"><div class="w cgd">
  <div>
    <h2 style="margin-top:37px">Ponte en contacto con Kallpa</h2>
    <div class="fi"><span>📍</span><div><h3>Ubicación</h3><p>[Calle / Av., zona], Oruro, Bolivia</p></div></div>
    <div class="fi"><span>💬</span><div><h3>WhatsApp</h3><p><a href="tel:+59170000000">7X XXX XXX</a></p></div></div>
    <div class="fi"><span>✉️</span><div><h3>Correo</h3><p>[correo de contacto]</p></div></div>
    <div class="si"><a href="#">f</a><a href="#">in</a></div>
  </div>
  <form id="f">
    <label>Nombre *</label><input id="n" required>
    <label>Correo electrónico</label><input id="m" type="email">
    <label>Celular *</label><input id="t" inputmode="tel" required>
    <label>Institución o grupo (opcional)</label><input id="e">
    <label>Servicio a cotizar</label><div class="ck" id="svc"></div>
    <label>Comentarios *</label><textarea id="c"></textarea>
    <a class="bt" id="w" href="#" target="_blank" rel="noopener" style="margin-top:14px">Enviar</a>
  </form>
</div></section>

<div class="mp"><div>🗺️<br>Mapa de ubicación<br><a href="https://www.google.com/maps" target="_blank" rel="noopener">Abrir en Google Maps</a></div></div>

<footer><div class="w">
  <a class="logo" href="#inicio" aria-label="KALLPA — Eventos y Alta Cocina"><img src="img/kallpa-logo-claro.svg" alt="KALLPA — Eventos y Alta Cocina" style="height:88px"></a>
  <h2>Menú de navegación</h2>
  <nav><a href="#inicio">Inicio</a><a href="#nosotros">Nosotros</a><a href="#servicios">Servicios</a><a href="#contacto">Contacto</a></nav>
  <hr>
  <p style="margin:0">© 2026 KALLPA — Eventos y Alta Cocina · Oruro, Bolivia<br>Todos los derechos reservados.</p>
</div></footer>
<a class="wa" id="wa" href="#" target="_blank" rel="noopener" aria-label="WhatsApp">💬</a>

<script>
var NUM="59170000000";
var sl=[].slice.call(document.querySelectorAll(".sl")),dots=document.getElementById("dots"),i=0,tm;
sl.forEach(function(_,k){var b=document.createElement("button");b.textContent="0"+(k+1);b.onclick=function(){go(k)};dots.appendChild(b)});
function go(k){i=k;sl.forEach(function(s,j){s.classList.toggle("on",j==k);dots.children[j].classList.toggle("on",j==k)});clearInterval(tm);tm=setInterval(function(){go((i+1)%sl.length)},7000)}
go(0);
document.getElementById("bg").onclick=function(){document.getElementById("mn").classList.toggle("open")};
document.getElementById("mn").onclick=function(){this.classList.remove("open")};
var S=["Línea Clásica (pollo)","Línea Reserva (cerdo)","Línea Gran Reserva (res)","Coctelería","Bocaditos","Postres","Servicio de garzones","Evento social","Evento folklórico","Evento académico","Evento institucional","Otro (Comentarios)"];
var box=document.getElementById("svc");
box.innerHTML=S.map(function(s){return '<label><input type="checkbox" value="'+s+'">'+s+'</label>'}).join("");
function upd(){
  var sel=[].slice.call(box.querySelectorAll("input:checked")).map(function(x){return x.value}).join(", ");
  var msg="Hola Kallpa, soy "+(n.value||"…")+(e.value?" de "+e.value:"")+". Quiero cotizar: "+(sel||"un evento")+". "+(c.value||"")+" Celular: "+(t.value||"…");
  w.href="https://wa.me/"+NUM+"?text="+encodeURIComponent(msg);
}
document.getElementById("f").addEventListener("input",upd);upd();
document.getElementById("wa").href="https://wa.me/"+NUM+"?text="+encodeURIComponent("Hola Kallpa, quiero más información sobre sus menús para eventos.");
</script>
</body>
</html>
